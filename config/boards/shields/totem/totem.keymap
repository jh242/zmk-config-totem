// TOTEM — QWERTY for Vim, Claude Code, React / Qt / C++
//
// Home-row mods tuned for fast/sloppy typing (urob-style):
// - opposite-hand only via hold-trigger-key-positions
// - require-prior-idle-ms → already typing = tap (kills roll false-holds)
// - hold-trigger-on-release → same-hand mod chords (Ctrl+Shift) still work
//
// Thumbs stay Corne-like (Space = right): Alt · Ctrl · Enter(NAV) | Space(SYM) · Esc · Gui

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3

// Position index map (keymap order):
//  0-4 left top   | 5-9 right top
// 10-14 left home | 15-19 right home
// 20-25 left bot  | 26-31 right bot
// 32-34 left thumbs | 35-37 right thumbs
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31
#define THUMBS 32 33 34 35 36 37

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <180>;
    quick-tap-ms = <120>;
    global-quick-tap;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <180>;
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        // Left home-row mods: hold only resolves against right hand (+ thumbs)
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Right home-row mods: hold only resolves against left hand (+ thumbs)
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <NUM>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc_jk {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp ESC>;
        };

        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
// -----------------------------------------------------------------------------------------
//           |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
//           |A/GUI|S/ALT|D/CTL|F/SFT|  G  |   |  H  |J/SFT|K/CTL|L/ALT|;/GUI|
// | Tab/Sft |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | Bspc |
//                     | Alt | Ctrl| Ent |   | Spc | Esc | Gui |
//                            NAV↑              SYM↑
            bindings = <
                        &kp Q          &kp W          &kp E          &kp R          &kp T            &kp Y          &kp U          &kp I          &kp O          &kp P
                        &hml LGUI A    &hml LALT S    &hml LCTRL D   &hml LSHFT F   &kp G            &kp H          &hmr RSHFT J   &hmr RCTRL K   &hmr RALT L    &hmr RGUI SEMI
            &mt LSHFT TAB &kp Z          &kp X          &kp C          &kp V          &kp B            &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp BSPC
                                                       &kp LALT       &kp LCTRL      &lt NAV RET      &lt SYM SPACE  &kp ESC        &kp LGUI
            >;
        };

        nav_layer {
            display-name = "NAV";
// Hold Enter (left) → numbers + vim arrows on the right.
// -----------------------------------------------------------------------------------------
//           |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |
//           |     |     |     |     |     |   |  ←  |  ↓  |  ↑  |  →  |  '  |
// |         |     |     |wDel |     |     |   |Home |PgDn |PgUp | End |  `  | Del  |
//                     |     | Ctrl|     |   |     |     |     |
            bindings = <
                        &kp N1    &kp N2    &kp N3       &kp N4    &kp N5        &kp N6    &kp N7    &kp N8    &kp N9    &kp N0
                        &trans    &trans    &trans       &trans    &trans        &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp APOS
            &trans      &trans    &trans    &kp LC(BSPC) &trans    &trans        &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp GRAVE &kp DEL
                                            &trans       &kp LCTRL &trans        &trans    &trans    &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
// Hold Space (right) → brackets / operators on the left.
// -----------------------------------------------------------------------------------------
//           |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |
//           |  [  |  ]  |  (  |  )  |  ~  |   |  -  |  =  |  {  |  }  |  |  |
// |         |  {  |  }  |  <  |  >  |     |   |  _  |  +  |      |      |  \  |  `   |
//                     |     | Ctrl|     |   |     |     |     |
            bindings = <
                        &kp EXCL  &kp AT    &kp HASH &kp DLLR &kp PRCNT      &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR
                        &kp LBKT  &kp RBKT  &kp LPAR &kp RPAR &kp TILDE      &kp MINUS &kp EQUAL &kp LBRC &kp RBRC &kp PIPE
            &trans      &kp LBRC  &kp RBRC  &kp LT   &kp GT   &trans         &kp UNDER &kp PLUS &trans    &trans   &kp BSLH &kp GRAVE
                                          &trans    &kp LCTRL &trans         &trans    &trans   &trans
            >;
        };

        num_layer {
            display-name = "NUM";
// NAV+SYM: numpad, F-keys, Bluetooth, flash helpers.
// -----------------------------------------------------------------------------------------
//           | F1  | F2  | F3  | F4  | F5  |   |  *  |  7  |  8  |  9  |  -  |
//           | BT0 | BT1 | BT2 | BT3 | BT4 |   |  /  |  4  |  5  |  6  |  +  |
// |  boot   | Clr | Out |     | F11 | F12 |   |  0  |  1  |  2  |  3  |  .  | Bspc |
//                     |     | Ctrl|     |   |     |     |     |
            bindings = <
                        &kp F1       &kp F2       &kp F3       &kp F4       &kp F5          &kp KP_MULTIPLY &kp N7 &kp N8 &kp N9 &kp KP_SUBTRACT
                        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &kp KP_DIVIDE   &kp N4 &kp N5 &kp N6 &kp KP_PLUS
            &bootloader &bt BT_CLR   &out OUT_TOG &trans       &kp F11      &kp F12         &kp N0          &kp N1 &kp N2 &kp N3 &kp DOT      &kp BSPC
                                                      &trans       &kp LCTRL    &trans          &trans          &trans &trans
            >;
        };
    };
};
