// TOTEM — QWERTY / Vim / Claude Code
// Ported from jh242/zmk-config Corne keymap; adapted for 38 keys.
//
// Layers: BASE → NAV (hold Enter) → SYM (hold Space) → NUM (NAV+SYM tri-layer)
// Outer bottoms: tap Tab / hold Shift  ·  Backspace

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <180>;
    quick-tap-ms = <120>;
    global-quick-tap;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <NUM>;
        };
    };

    combos {
        compatible = "zmk,combos";
        // Q+W → Esc (vim reflex; Esc also on right thumb)
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
        // J+K → Escape (vim home-row; works even when thumbs are busy)
        combo_esc_jk {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
// -----------------------------------------------------------------------------------------
//           |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
//           |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |
// | Tab/Shft|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | BSPC |
//                     | Alt | Ctrl| Ent |   | Spc | Esc | Gui |
//                            NAV↑              SYM↑
            bindings = <
                        &kp Q        &kp W     &kp E      &kp R       &kp T           &kp Y        &kp U     &kp I      &kp O      &kp P
                        &kp A        &kp S     &kp D      &kp F       &kp G           &kp H        &kp J     &kp K      &kp L      &kp SEMI
            &mt LSHFT TAB &kp Z        &kp X     &kp C      &kp V       &kp B           &kp N        &kp M     &kp COMMA  &kp DOT    &kp FSLH   &kp BSPC
                                             &kp LALT  &kp LCTRL  &lt NAV RET     &lt SYM SPACE &kp ESC  &kp LGUI
            >;
        };

        nav_layer {
            display-name = "NAV";
// -----------------------------------------------------------------------------------------
//           |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |
//           | BT0 | BT1 | BT2 | BT3 | BT4 |   |  ←  |  ↓  |  ↑  |  →  |  '  |
// |         | Clr |     |     | Out |     |   |Home |PgDn |PgUp | End |  `  | Del  |
//                     |     | Ctrl|     |   |     |     |     |
// Vim arrows on H J K L. Numbers on top row. BT profiles on left home.
            bindings = <
                        &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6    &kp N7    &kp N8    &kp N9     &kp N0
                        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &kp APOS
            &trans      &bt BT_CLR   &trans       &trans       &out OUT_TOG &trans         &kp HOME  &kp PG_DN &kp PG_UP &kp END    &kp GRAVE  &kp DEL
                                             &trans       &kp LCTRL    &trans          &trans     &trans    &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
// -----------------------------------------------------------------------------------------
//           |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |
//           |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |
// |         |     |     |     |     |     |   |  _  |  +  |  {  |  }  |  |  |  ~   |
//                     |     | Ctrl|     |   |     |     |     |
// Programming symbols right-weighted (React / C++ / Qt).
            bindings = <
                        &kp EXCL     &kp AT    &kp HASH   &kp DLLR   &kp PRCNT       &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR
                        &trans       &trans    &trans     &trans     &trans          &kp MINUS  &kp EQUAL &kp LBKT   &kp RBKT  &kp BSLH
            &trans      &trans       &trans    &trans     &trans     &trans          &kp UNDER  &kp PLUS  &kp LBRC   &kp RBRC  &kp PIPE   &kp TILDE
                                             &trans     &kp LCTRL  &trans          &trans     &trans    &trans
            >;
        };

        num_layer {
            display-name = "NUM";
// -----------------------------------------------------------------------------------------
//           |     |     |     |     |     |   |  *  |  7  |  8  |  9  |  -  |
//           |     |     |     |     |     |   |  /  |  4  |  5  |  6  |  +  |
// |         |     |     |     |     |     |   |  0  |  1  |  2  |  3  |  .  | BSPC |
//                     |     | Ctrl|     |   |     |     |     |
// Tri-layer (NAV+SYM). Numpad on right.
            bindings = <
                        &kp F1       &kp F2    &kp F3     &kp F4     &kp F5          &kp KP_MULTIPLY &kp N7 &kp N8 &kp N9 &kp KP_MINUS
                        &kp F6       &kp F7    &kp F8     &kp F9     &kp F10         &kp KP_DIVIDE   &kp N4 &kp N5 &kp N6 &kp KP_PLUS
            &bootloader &sys_reset   &trans    &trans     &kp F11    &kp F12         &kp N0          &kp N1 &kp N2 &kp N3 &kp DOT      &kp BSPC
                                             &trans     &kp LCTRL  &trans          &trans          &trans &trans
            >;
        };
    };
};
